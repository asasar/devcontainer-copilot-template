{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/session-start-audit.sh",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": ".github/hooks/session-stop-audit.sh",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
